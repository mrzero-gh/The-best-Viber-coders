{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-gym.local/schemas/grader_log.schema.json",
  "title": "Строка журнала оценщика runs/<run_id>/grader_log.jsonl",
  "description": "Одна строка на завершённый эпизод, пишет env.server в обоих режимах. Агенту не передаётся.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "episode_id", "mode", "seed", "config_version", "status", "steps_used",
               "inspection_steps", "reward", "valid", "error", "metrics", "episode_sha256"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["train", "eval"]},
    "seed": {"type": ["integer", "null"], "description": "null, если эпизод загружен с диска (--episode)"},
    "config_version": {"type": ["string", "integer", "null"]},
    "status": {"enum": ["submitted", "invalid_findings", "step_limit", "time_limit"]},
    "steps_used": {"type": "integer", "minimum": 0, "maximum": 100},
    "inspection_steps": {"type": "integer", "minimum": 0, "maximum": 100},
    "reward": {"type": "number", "minimum": -1, "maximum": 1},
    "valid": {"type": "boolean"},
    "error": {"type": ["string", "null"]},
    "metrics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tp", "fp", "fn", "precision", "recall", "f1"],
      "properties": {
        "tp": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0},
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "f1": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "episode_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
