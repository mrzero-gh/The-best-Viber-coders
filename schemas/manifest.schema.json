{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-gym.local/schemas/manifest.schema.json",
  "title": "manifest.json — паспорт эпизода",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "base_currency", "period_start", "period_end", "timezone", "counts", "rounding", "currency_exponents", "csv_null", "config_version"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string", "pattern": "^EP-[0-9A-HJKMNP-TV-Z]{8}$"},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "period_start": {"$ref": "#/$defs/timestamp", "description": "Включительно"},
    "period_end": {"$ref": "#/$defs/timestamp", "description": "Не включительно"},
    "timezone": {"type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["ledger_rows", "invoices", "payments", "fx_rates", "documents"],
      "properties": {
        "ledger_rows": {"type": "integer", "minimum": 0},
        "invoices": {"type": "integer", "minimum": 0},
        "payments": {"type": "integer", "minimum": 0},
        "fx_rates": {"type": "integer", "minimum": 0},
        "documents": {"type": "integer", "minimum": 0}
      }
    },
    "rounding": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {"mode": {"enum": ["ROUND_HALF_EVEN"]}}
    },
    "currency_exponents": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {"^[A-Z]{3}$": {"type": "integer", "minimum": 0, "maximum": 4}}
    },
    "csv_null": {"const": ""},
    "config_version": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"}
  }
}
